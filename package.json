{
  "name": "betterncm-mac",
  "version": "0.1.1",
  "description": "BetterNCM II for NetEase Cloud Music on macOS, injected over the Chrome DevTools Protocol without modifying the app",
  "keywords": [
    "betterncm",
    "netease-cloud-music",
    "macos",
    "refinednowplaying"
  ],
  "homepage": "https://github.com/OyangDer/betterncm-mac#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OyangDer/betterncm-mac.git"
  },
  "bugs": {
    "url": "https://github.com/OyangDer/betterncm-mac/issues"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "bin": {
    "bncm-mac": "bin/bncm-mac.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "resources/",
    "vendor/",
    "app-wrapper/",
    "scripts/build-app.mjs",
    "install.sh",
    "framework/",
    "!framework/node_modules/",
    "patches/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:fw": "cd framework && npm ci && npm run build",
    "patch:fw": "node scripts/vendor-framework.mjs",
    "start": "node bin/bncm-mac.mjs launch",
    "attach": "node bin/bncm-mac.mjs attach",
    "doctor": "node bin/bncm-mac.mjs doctor",
    "install-app": "node bin/bncm-mac.mjs install-app",
    "test": "node --test 'test/*.test.mjs'"
  },
  "license": "GPL-3.0-only"
}
